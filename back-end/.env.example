# Server port (leave as 5000 unless it conflicts with another service)
PORT=5000

# Paste your MongoDB Atlas or local MongoDB connection string here. The app uses
# the verifyai database automatically; do not put credentials in this file.
MONGO_URI=

# Generate a long random secret for signing JSON Web Tokens.
JWT_SECRET=

# One or more frontend origins, separated by commas when needed.
CLIENT_URL=http://localhost:5173

# Optional future integrations. Leave blank until a real service is enabled.
EXTERNAL_API_KEY=
AI_API_KEY=
NEWS_API_KEY=
STORAGE_API_KEY=
