APP_NAME=factchecker-ai
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TEXT_ENCODER_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_ENCODER_DEVICE=auto
TEXT_ENCODER_BATCH_SIZE=8
TEXT_ENCODER_CHUNK_SIZE=4000
IMAGE_ENCODER_MODEL=ViT-B-32
IMAGE_ENCODER_CHECKPOINT=openai
IMAGE_ENCODER_DEVICE=auto
IMAGE_ENCODER_BATCH_SIZE=4
# Optional absolute path for Task 36C's checkpoint; the file must match its recorded SHA-256.
# TASK36C_OPENCLIP_CHECKPOINT=/path/to/ViT-B-32.pt
WHISPER_MODEL_VARIANT=tiny
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=
WHISPER_TASK=transcribe
WHISPER_MAX_DURATION_SECONDS=600
WHISPER_CHUNK_SECONDS=
OCR_LANGUAGES=en
OCR_DEVICE=auto
OCR_USE_GPU=false
OCR_MODEL_DIRECTORY=
OCR_PARAGRAPH_MODE=false
